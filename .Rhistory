# Silhouette analysis
library(cluster)
library(factoextra)
#1. Extract PCA-transformed data
rnase_sil_df <- rnase_pca$x
#2. Placeholder for average silhouette widths
rnase_avg_sil <- numeric(length = 9)
# 3. Calculate silhouette scores for different k values
k_values <- 2:10
for (i in seq_along(k_values)) {
k <- k_values[i]
rnase_km <- kmeans(rnase_sil_df, centers = k, nstart = 25)
rnase_ss <- silhouette(rnase_km$cluster, dist(rnase_sil_df))
rnase_avg_sil[i] <- mean(rnase_ss[, 3])
}
# 4. Plot similar to elbow method
plot(k_values, rnase_avg_sil, type = "b", pch = 19,
xlab = "Number of clusters (k)",
ylab =  "Average silhouette width",
main = "Silhouette analysis to determine the optimum number of clusters, RNAse")
# 5. Identify the best k based on max silhouette width
best_k <- k_values[which.max(rnase_avg_sil)]
# 6. Run K-Means and compute the  silhouette for the best k
rnase_km_best <- kmeans(rnase_sil_df, centers = best_k, nstart = 25)
rnase_best_sil <- silhouette(rnase_km_best$cluster, dist(rnase_sil_df))
# 7. Visualize silhouette plot
palette_colors <- c("#c9a0dc", "#A9C1A6", "#F5E1A4")[1:best_k]
fviz_silhouette(
rnase_best_sil,
palette = palette_colors,
ggtheme = theme_classic(),
main = paste("RNAse silhouette plot for k =", best_k)
)
