library(ggbiplot)
#1. axis
my_var_explained <- c(40.95, 22.63)
#2. plot
ggbiplot(ctrl_pca,
obs.scale = 1,
var.scale = 1,
ellipse = FALSE,
circle = TRUE,
var.axes = TRUE) +
xlab(paste0("PC1 (", round(my_var_explained[1], 1), "%)")) +
ylab(paste0("PC2 (", round(my_var_explained[2], 1), "%)")) +
theme_minimal()+
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 14)) +
guides(colour = "none")
#1. calculate wss: within-cluster sum of squares
wss <- sapply(1:25, function(k){
kmeans(ctrl_pca$x, centers = k, nstart = 25)$tot.withinss
})
#2. plot
plot(1:25, wss, type = "b", pch = 19,
xlab = "Number of clusters (k)",
ylab = "Total within-cluster-variance",
main = "Elbow method to determin optimal cluster amount, ctrl")
# Silhouette analysis
library(cluster)
library(factoextra)
# 1. Extract PCA-transformed data
ctrl_sil_df <- ctrl_pca$x
# 2. Placeholder for average silhouette widths
ctrl_avg_sil <- numeric(length = 9)  # for k = 2 to 10
# 3. Calculate silhouette scores for different k values
k_values <- 2:10
for (i in seq_along(k_values)) {
k <- k_values[i]
ctrl_km <- kmeans(ctrl_sil_df, centers = k, nstart = 25)
ctrlc_ss <- silhouette(ctrl_km$cluster, dist(ctrl_sil_df))
ctrl_avg_sil[i] <- mean(ctrlc_ss[, 3])
}
# 4. Plot similar to elbow method
plot(k_values, ctrl_avg_sil, type = "b", pch = 19,
xlab = "Number of clusters (k)",
ylab = "Average silhouette width",
main = "Silhouette analysis to determine the optimum number of clusters, ctrl")
# 5. Identify best k based on max silhouette width
best_k <- k_values[which.max(ctrl_avg_sil)]
# 6. Run KMeans and compute silhouette for best k
km_best <- kmeans(ctrl_sil_df, centers = best_k, nstart = 25)
ctrl_best_sil <- silhouette(km_best$cluster, dist(ctrl_sil_df))
# 7. Visualize silhouette plot
fviz_silhouette(
ctrl_best_sil,
palette = c("#c9a0dc", "#A9C1A6"),
ggtheme = theme_classic(),
main = paste("Ctrl silhouette plot for k =", best_k)
)
#1. apply kmeans to reduced data set
# using k=2
#kmeans runs 25 and uses best result
C_kmeans_result <- kmeans(ctrl_pca$x, centers = 2, nstart = 25)
#1. in which cluster every obserbation is assigned to
C_kmeans_result$cluster
#2. coordinates the cluster center
C_kmeans_result$centers
#3. shows how compact the clusters are using WSS
# lower WSS means a more compact cluster
C_kmeans_result$tot.withinss
#1. prepare data
#save pca matrix into data frame
# add cluster column
ctrl_data <- as.data.frame(ctrl_pca$x)
ctrl_data$cluster <- as.factor(C_kmeans_result$cluster)
#2. plot
library(ggplot2)
ggplot(ctrl_data, aes(x = PC1, y = PC2, color = cluster)) +
geom_point(alpha = 0.7, size = 2) +
labs(title = "K-means clusters in PCA area, ctrl",
x = "Principal component 1 (40.95%)",
y = "Principal component 2 (22.63%)") +
theme_minimal() +
scale_color_manual(values = c("#c9a0dc","#A9C1A6"))
first_two_components <- ctrl_data[,1:2]
plot(first_two_components)
rnase_perc_df <- as.data.frame(percent_rnase_df[,-1])
rownames(rnase_perc_df) <- rnase_perc_df$X
