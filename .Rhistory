ctrl_cols <- c("Protein_Name", grep("Ctrl", col_names, value = TRUE))
rnase_cols <- c("Protein_Name", grep("RNase", col_names, value = TRUE))
# create dataframe
df_ctrl <- A549_NS[, ctrl_cols, drop = FALSE]
df_rnase <- A549_NS[, rnase_cols, drop = FALSE]
