grid$predicted <- predict(model, newdata = grid)
# determine colors
farben <- list("RBP_left" = "#c9a0dc",     # hell-lila
"RBP_right" = "#7a42a6",    # dunkel-lila
"RBP" = "purple",
"Non-RBP" = "lightgray")
# Plotly Plot
fig <- plot_ly()
# RBP_left
fig <- fig %>%
add_markers(data = subset(df_complete, RBP_shift_category == "RBP_left"),
x = ~pI, y = ~Mass_kDa, z = ~probability,
marker = list(color = farben[["RBP_left"]], size = 4),
name = "RBP (left shift)")
# RBP_right
fig <- fig %>%
add_markers(data = subset(df_complete, RBP_shift_category == "RBP_right"),
x = ~pI, y = ~Mass_kDa, z = ~probability,
marker = list(color = farben[["RBP_right"]], size = 4),
name = "RBP (right shift)")
# RBP without Shift-Direction
fig <- fig %>%
add_markers(data = subset(df_complete, RBP_shift_category == "RBP"),
x = ~pI, y = ~Mass_kDa, z = ~probability,
marker = list(color = farben[["RBP"]], size = 4),
name = "RBP (no shift info)")
# Non-RBP
fig <- fig %>%
add_markers(data = subset(df_complete, RBP_shift_category == "Non-RBP"),
x = ~pI, y = ~Mass_kDa, z = ~probability,
marker = list(color = farben[["Non-RBP"]], size = 4),
name = "Non-RBP")
# Regressionplane
fig <- fig %>%
add_surface(x = ~pI_seq,
y = ~Mass_seq,
z = matrix(grid$predicted, nrow = 30),
opacity = 0.5,
colorscale = "Purples",
showscale = FALSE,
name = "Regression Surface")
# Layout
fig <- fig %>%
layout(scene = list(
xaxis = list(title = "pI"),
yaxis = list(title = "Mass (kDa)", tick0 = 0, dtick = 100, range = c(0, 1000)),
zaxis = list(title = "Probability")
),
legend = list(title = list(text = "<b>Protein Classification</b>")))
fig
install.packages("plotly")
#hypothesis: proteins with a higher pI are more significantly more likely to be RBPs -> have positively charged domains at physiological pH -> are more likely to bind negatively charged RNA
# Group proteins based on optimal threshold:
df_complete$RBP_group <- ifelse(df_complete$probability > optimal_threshold,
"RBP", "Non-RBP")
# Optional: check mean pI values per group to confirm
aggregate(pI ~ RBP_group, data = df_complete, mean)
# Perform one-sided Welch Two Sample t-test comparing pI of RBP vs Non-RBP
# as big sample sizes are used, it was assumed that the central limit theorem applies (meaning the data follows a normal distribution)
t_test_result <- t.test(
df_complete$pI[df_complete$RBP_group == "RBP"],
df_complete$pI[df_complete$RBP_group == "Non-RBP"],
alternative = "greater"
)
print(t_test_result)
# create boxplot
boxplot(pI ~ RBP_group,
data = df_complete,
col = c("#A9C1A6", "#c9a0dc"),
main = "compare pI\nbetween RBP and Non-RBP",
xlab = "group",
ylab = "isoelectric point (pI)")
# calculate mean
mean_rbp <- mean(df_complete$pI[df_complete$RBP_group == "RBP"])
mean_nonrbp <- mean(df_complete$pI[df_complete$RBP_group == "Non-RBP"])
print(mean_rbp)
print(mean_nonrbp)
# depict mean in plot
points(c(1, 2), c(mean_nonrbp, mean_rbp), pch = 19, col = "coral")
# Oadd legend
legend("topright", legend = c("Mean"), col = "coral", pch = 19)
#check whether mass differs significantly between RBPs and Non-RBPs
# Perform two-sided Welch Two Sample t-test comparing pI of RBP vs Non-RBP
t_test_result <- t.test(
df_complete$Mass_kDa[df_complete$RBP_group == "RBP"],
df_complete$Mass_kDa[df_complete$RBP_group == "Non-RBP"],
)
print(t_test_result)
ctrl_perc_df <- as.data.frame(percent_ctrl_df[,-1])
rownames(ctrl_perc_df) <- ctrl_perc_df$X
C_test <- ctrl_perc_df
str(C_test)
# we have 3680 observations and 75 features
apply(C_test, 2, mean)
apply(C_test, 2, sd)
ctrl_pca <- prcomp(ctrl_perc_df, center = TRUE, scale = TRUE)
names(ctrl_pca)
head(ctrl_pca$x, 10)
ctrl_pca$rotation
ctrl_pca$sdev
ctrl_pca_var <- ctrl_pca$sdev^2 # eigenvalues
ctrl_pca_var
ctrl_pca_ve <- ctrl_pca_var / sum(ctrl_pca_var)
ctrl_pca_ve_percent <- ctrl_pca_ve * 100
ctrl_pca_ve_percent
#1. plot
plot(ctrl_pca_ve_percent, type = "b", pch = 19,
xlab = "Principal Component",
ylab = "Explained Variance (%)",
main = "Scree Plot: Explained Variance per PC, ctrl")
#plot
bar_positions <- barplot(ctrl_pca_ve_percent,
main = "Explained Variance per PC (in %), ctrl",
xlab = "Principal Component",
ylab = "Explained Variance (%)",
col = "#c9a0dc",
las = 2,
xaxt = "n")  # keine x-Achsen-Beschriftung
axis(1, at = bar_positions, labels = paste0("PC", 1:length(ctrl_pca_ve_percent)), las = 2)
#1. plot
biplot(ctrl_pca, scale = 0, cex = 0.6,
col = c("black", "#c9a0dc"),
main="PCA biplot, ctrl",
xlab = "PC1 (44% variance explained)",
ylab = "PC2 (21% variance explained)")
library(ggbiplot)
#1. axis
my_var_explained <- c(40.95, 22.63)
#2. plot
ggbiplot(ctrl_pca,
obs.scale = 1,
var.scale = 1,
ellipse = FALSE,
circle = TRUE,
var.axes = TRUE) +
xlab(paste0("PC1 (", round(my_var_explained[1], 1), "%)")) +
ylab(paste0("PC2 (", round(my_var_explained[2], 1), "%)")) +
theme_minimal()+
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 14)) +
guides(colour = "none")
#1. calculate wss: within-cluster sum of squares
wss <- sapply(1:25, function(k){
kmeans(ctrl_pca$x, centers = k, nstart = 25)$tot.withinss
})
#2. plot
plot(1:25, wss, type = "b", pch = 19,
xlab = "Number of clusters (k)",
ylab = "Total within-cluster-variance",
main = "Elbow method to determin optimal cluster amount, ctrl")
# Silhouette analysis
library(cluster)
library(factoextra)
# 1. Extract PCA-transformed data
ctrl_sil_df <- ctrl_pca$x
# 2. Placeholder for average silhouette widths
ctrl_avg_sil <- numeric(length = 9)  # for k = 2 to 10
# 3. Calculate silhouette scores for different k values
k_values <- 2:10
for (i in seq_along(k_values)) {
k <- k_values[i]
ctrl_km <- kmeans(ctrl_sil_df, centers = k, nstart = 25)
ctrlc_ss <- silhouette(ctrl_km$cluster, dist(ctrl_sil_df))
ctrl_avg_sil[i] <- mean(ctrlc_ss[, 3])
}
# 4. Plot similar to elbow method
plot(k_values, ctrl_avg_sil, type = "b", pch = 19,
xlab = "Number of clusters (k)",
ylab = "Average silhouette width",
main = "Silhouette analysis to determine the optimum number of clusters, ctrl")
# 5. Identify best k based on max silhouette width
best_k <- k_values[which.max(ctrl_avg_sil)]
# 6. Run KMeans and compute silhouette for best k
km_best <- kmeans(ctrl_sil_df, centers = best_k, nstart = 25)
ctrl_best_sil <- silhouette(km_best$cluster, dist(ctrl_sil_df))
# 7. Visualize silhouette plot
fviz_silhouette(
ctrl_best_sil,
palette = c("#c9a0dc", "#A9C1A6"),
ggtheme = theme_classic(),
main = paste("Ctrl silhouette plot for k =", best_k)
)
#1. apply kmeans to reduced data set
# using k=2
#kmeans runs 25 and uses best result
C_kmeans_result <- kmeans(ctrl_pca$x, centers = 2, nstart = 25)
#1. in which cluster every obserbation is assigned to
C_kmeans_result$cluster
#2. coordinates the cluster center
C_kmeans_result$centers
#3. shows how compact the clusters are using WSS
# lower WSS means a more compact cluster
C_kmeans_result$tot.withinss
#1. prepare data
#save pca matrix into data frame
# add cluster column
ctrl_data <- as.data.frame(ctrl_pca$x)
ctrl_data$cluster <- as.factor(C_kmeans_result$cluster)
#2. plot
library(ggplot2)
ggplot(ctrl_data, aes(x = PC1, y = PC2, color = cluster)) +
geom_point(alpha = 0.7, size = 2) +
labs(title = "K-means clusters in PCA area, ctrl",
x = "Principal component 1 (40.95%)",
y = "Principal component 2 (22.63%)") +
theme_minimal() +
scale_color_manual(values = c("#c9a0dc","#A9C1A6"))
first_two_components <- ctrl_data[,1:2]
plot(first_two_components)
