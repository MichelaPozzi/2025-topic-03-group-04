apply(R_TEST, 2, sd)
rnase_pca <- prcomp(rnase_perc_df, center = TRUE, scale = TRUE)
names(rnase_pca)
rnase_pca$rotation
rnase_pca$sdev
rnase_pca_var <- rnase_pca$sdev^2 # eigenvalues
rnase_pca_var
rnase_pca_ve <- rnase_pca_var / sum(rnase_pca_var)
rnase_pca_ve_percent <- rnase_pca_ve * 100
rnase_pca_ve_percent
